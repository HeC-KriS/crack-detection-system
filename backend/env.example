# ================================================================
# Crack Detection System — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ================================================================

# ── App ─────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=89cfbae11d4c91ad58279fe59c12bfcecbc176320601ea9d66723b26767c12ab
# SECRET_KEY=replace-with-a-64-char-random-string-from-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=900
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ─────────────────────────────────────────────────────
# SQLite (default, no extra setup):
DATABASE_URL=sqlite+aiosqlite:///./crack_detection.db

# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql+asyncpg://crackuser:crackpass@localhost:5432/crackdb

# ── ML Model ─────────────────────────────────────────────────────
MODEL_PATH=C:\Users\Dhruv Mohan\Documents\BPCL_Project\crack-detection-system\backend\best-2.pt
INFERENCE_DEVICE=cpu
# Use cuda:0 for GPU inference: INFERENCE_DEVICE=cuda:0
INFERENCE_WORKERS=2
INFERENCE_QUEUE_MAX=50

# ── Frame Capture ────────────────────────────────────────────────
DEFAULT_FRAME_INTERVAL_SECONDS=5
OPENCV_CAPTURE_TIMEOUT_MS=3000
CAMERA_RECONNECT_MAX_RETRIES=10
CAMERA_RECONNECT_BACKOFF_MAX_S=60

# ── Alerting ─────────────────────────────────────────────────────
DEFAULT_ALERT_THRESHOLD=0.45
ALERT_COOLDOWN_SECONDS=120

# ── Storage ──────────────────────────────────────────────────────
FLAGGED_IMAGES_DIR=./data/flagged
MAX_FLAGGED_IMAGE_SIZE_MB=10

# ── Slack ────────────────────────────────────────────────────────
SLACK_ENABLED=false
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL=#crack-alerts

# ── Email ────────────────────────────────────────────────────────
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=dhruvmohan1202@gmail.com
SMTP_PASSWORD=1234567
ALERT_EMAIL_FROM=dhruvmohan1202@gmail.com
ALERT_EMAIL_TO=["dhruvmohan1202@gmail.com"]

# ── Dashboard ────────────────────────────────────────────────────
DASHBOARD_BASE_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Admin ────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_EMAIL=the mail you want to use for admin login
ADMIN_PASSWORD=IamLocked
